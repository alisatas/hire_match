# Copy to keystore.properties (git-ignored) and fill in. Create the upload key once with:
#   keytool -genkeypair -v -keystore upload.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
# Keep upload.jks and its passwords safe and backed up: losing them blocks future updates
# until Google resets the upload key.
storeFile=upload.jks
storePassword=
keyAlias=upload
keyPassword=

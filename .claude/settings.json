{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/aliisatas/Desktop/hire-match/update-canvas.mjs 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking push prerequisites"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-subject.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
